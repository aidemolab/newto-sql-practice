# Copy this file to a new file called .env and fill in the password.
# The .env file stays on this computer only; Git ignores it.

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=retailhub
DB_USER=practice_ro
DB_PASSWORD=put-the-practice_ro-password-here

# Optional limits (these are the defaults)
MAX_ROWS=500
TIMEOUT_SECONDS=5
MAX_CONCURRENT=8

# Optional: if set, the page asks for this code before it runs anything.
# Recommended on the public server. Leave empty on your own laptop.
ACCESS_CODE=
