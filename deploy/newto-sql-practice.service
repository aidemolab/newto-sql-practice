# Newto SQL Practice - service file for Ubuntu (systemd)
# Tells the server: run the app permanently, start it at boot,
# and restart it if it ever stops.
#
# Install (once):
#   sudo cp deploy/newto-sql-practice.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now newto-sql-practice
#
# Paths assume the code is in /home/alaa/newto-sql-practice.

[Unit]
Description=Newto SQL Practice (pilot app)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=alaa
Group=alaa
WorkingDirectory=/home/alaa/newto-sql-practice
ExecStart=/home/alaa/newto-sql-practice/.venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 80
Restart=always
RestartSec=3

# Port 80 is normally reserved for root. This grants the app that one
# permission and nothing else, so it can still run as the ordinary user alaa.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
